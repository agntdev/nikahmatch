[
  {
    "name": "Direct language settings remain available",
    "steps": [
      {
        "send": { "callback": "settings:open" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Выберите язык интерфейса." } }]
      }
    ]
  },
  {
    "name": "English can still be selected directly",
    "steps": [
      {
        "send": { "callback": "settings:lang:en" },
        "expect": [{ "method": "sendMessage", "payload": { "text": "Language saved: English." } }]
      }
    ]
  }
]
