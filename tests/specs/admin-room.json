[
  {
    "name": "Admin Room rejects a wrong code and allows retry",
    "steps": [
      {
        "send": { "callback": "admin:entry" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Введите числовой код доступа к комнате админа." } }
        ]
      },
      {
        "send": { "text": "000000" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Код не подошёл. Введите числовой код ещё раз." } }
        ]
      }
    ]
  },
  {
    "name": "Admin Room accepts the code and shows Russian menu",
    "steps": [
      {
        "send": { "text": "/admin" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Введите числовой код доступа к комнате админа." } }
        ]
      },
      {
        "send": { "text": "123477" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Комната админа открыта. Выберите раздел:" } }
        ]
      }
    ]
  },
  {
    "name": "Admin Room logout ends the session",
    "steps": [
      {
        "send": { "text": "/admin" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Введите числовой код доступа к комнате админа." } }
        ]
      },
      {
        "send": { "text": "123477" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Комната админа открыта. Выберите раздел:" } }
        ]
      },
      {
        "send": { "callback": "admin:logout" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Вы вышли из комнаты админа." } }
        ]
      },
      {
        "send": { "callback": "admin:entry" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Введите числовой код доступа к комнате админа." } }
        ]
      }
    ]
  }
]
