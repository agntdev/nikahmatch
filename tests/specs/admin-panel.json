[
  {
    "name": "admin panel is unavailable until ADMIN_IDS is configured",
    "steps": [
      {
        "send": { "text": "/admin" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Доступ администратора пока не настроен." }
          }
        ]
      }
    ]
  },
  {
    "name": "admin callbacks are protected for regular users",
    "steps": [
      {
        "send": { "callback": "admin:open" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Доступ администратора пока не настроен." }
          }
        ]
      }
    ]
  }
]
